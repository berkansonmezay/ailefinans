# ==================================================
# Aile Finans - API Ortam Değişkenleri (Environment Variables)
# ==================================================

# Sunucu Portu
PORT=4000
NODE_ENV=production

# Veritabanı Bağlantısı (Supabase / PostgreSQL)
# Supabase Transaction Pooler URL (Prisma sorguları için):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection URL (Prisma migration ve db push işlemleri için):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Yetkilendirme Ayarları
JWT_SECRET="guclu-ve-rastgele-bir-jwt-anahtari-belirleyin"
JWT_EXPIRES_IN="7d"

# Frontend Web URL (CORS ve şifre sıfırlama mailleri için)
FRONTEND_URL="https://ailefinans.vercel.app"

# ==================================================
# Supabase Storage (Fatura, Fiş ve Garanti Belgeleri)
# ==================================================
# Supabase Dashboard -> Project Settings -> API kısmından alınır:
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# Project API Key (service_role key veya anon key):
SUPABASE_KEY="eyJhbGciOi..."
# Storage kısmında oluşturulan genel bucket adı:
SUPABASE_STORAGE_BUCKET="documents"

# ==================================================
# E-posta Bildirimleri (Resend / SMTP)
# ==================================================
# Seçenek 1 (Resend - Önerilen):
# RESEND_API_KEY="re_123456789abcdef..."
# SMTP_FROM="Aile Finans <onboarding@resend.dev>"

# Seçenek 2 (Tekil SMTP URL - Gmail, Brevo vb.):
# SMTP_URL="smtps://kullanici%40gmail.com:uygulama_sifresi@smtp.gmail.com:465"
# SMTP_FROM="Aile Finans <kullanici@gmail.com>"

# Seçenek 3 (Ayrık SMTP Ayarları):
# SMTP_HOST="smtp.resend.com"
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER="resend"
# SMTP_PASS="re_..."
# SMTP_FROM="Aile Finans <noreply@alanadi.com>"
